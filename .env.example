# NetSentry Configuration

# Network interface for packet capture
# Use 'auto' for automatic interface detection
# Otherwise specify interface name (e.g., eth0, wlan0, en0)
NETSENTRY_INTERFACE=auto

# Enable promiscuous mode for packet capture
CAPTURE_PROMISC_MODE=true

# Flow timeout in seconds (flows inactive longer than this are expired)
FLOW_TIMEOUT_SECONDS=300

# Database path
DATABASE_URL=sqlite:///./data/netsentry.db

# API server host and port
API_HOST=0.0.0.0
API_PORT=8000

# Logging level
LOG_LEVEL=INFO
